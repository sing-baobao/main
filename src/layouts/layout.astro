---
import '../styles/global.css';

interface Props {
  title?: string;
}

const { title = "Singbaobao" } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

    <!-- Header Navigation -->
    <header>
        <div class="header-container">
            <div class="brand">
                <div class="brand-logo">Singbaobao</div>
                <div class="brand-badge">
                    <img src="/beetl.svg" alt="Singbaobao Logo" />
                </div>
            </div>
            <nav>
                <ul>
                    <li><a href="#projects"><i class="fa-solid fa-cubes mr-1"></i> Current Work</a></li>
                    <li><a href="#services"><i class="fa-solid fa-gears mr-1"></i> Core Interests</a></li>
                    <li><a href="#about"><i class="fa-solid fa-user mr-1"></i> About Me</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <!-- Page Slot -->
    <slot />

    <!-- Footer -->
    <footer>
        <div class="container">
            <p>&copy; 2026 singbaobao.com &bull; All Rights Reserved</p>
            <p class="text-xs text-gray-400 mt-1">Built with Astro architecture principles • Hosted on GitHub Pages & Cloudflare Edge</p>
        </div>
    </footer>

</body>
</html>